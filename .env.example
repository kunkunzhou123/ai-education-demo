# 在本地复制为 .env，并填入 DeepSeek API Key。
DEEPSEEK_API_KEY=
PORT=4173
# 评估模型可独立配置。接口需兼容 chat/completions 与原生 tool calls。
ASSESSMENT_MODEL=deepseek-chat
# 可使用独立密钥，不配置时沿用 DEEPSEEK_API_KEY。
# ASSESSMENT_API_KEY=
# ASSESSMENT_BASE_URL=https://api.deepseek.com/chat/completions
# 规划员可独立使用模型，但与评估员共享上面的接口和密钥。
# PLANNER_MODEL=deepseek-chat
# 单轮硬上限。失败重试复用同一个run，调用预算不会重置。
HARNESS_MAX_STEPS=8
HARNESS_MAX_MODEL_CALLS=6
HARNESS_MAX_OUTPUT_TOKENS=1200
HARNESS_MODEL_TIMEOUT_MS=30000
HARNESS_RUN_TIMEOUT_MS=90000
HARNESS_MAX_CONTEXT_CHARS=14000
# 估算用量预留 + 服务商已报告用量的单会话预算，不是价格或信用额度。
HARNESS_MAX_SESSION_TOKENS=100000
RETENTION_HOURS=24
# 会话数据目录默认 data/sessions，不会提交到 Git。
# MASTERY_DATA_DIR=/absolute/path/to/private/sessions
